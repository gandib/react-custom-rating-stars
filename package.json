{
  "name": "react-custom-rating-stars",
  "version": "1.0.6",
  "description": "A custom rating stars component for React",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "react": "^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.4"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts"
  },
  "keywords": [
    "react",
    "rating",
    "stars",
    "component",
    "ui"
  ],
  "author": "Gandib Dhari Roy",
  "license": "MIT",
  "dependencies": {
    "lucide-react": "^0.503.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gandib/react-custom-rating-stars"
  },
  "homepage": "https://github.com/gandib/react-custom-rating-stars#readme",
  "bugs": {
    "url": "https://github.com/gandib/react-custom-rating-stars/issues"
  }
}
